PORT=8088
LIVE_TRADING=true

# Worst limit for market BUY = ceil(entry * mult to tick); default 1.18 (wider than legacy 1.05). Range 1.0–2.0.
# POLYMARKET_MARKET_SLIPPAGE_MULT=1.25

POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=


POLYMARKET_PROXY_WALLET=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIG_TYPE=3


PROXY_URL=http://127.0.0.1:15236

TAKE_PROFIT_PERCENT=0.20
STOP_LOSS_PERCENT=0.10
TRAILING_STOP_PERCENT=0.10

REDIS_URL=

# Append JSON lines for every POST /order and GET /data/order/{id} (HTTP status + body).
# Default when LIVE_TRADING=true is ./clob_audit.jsonl. Set to - or off to disable.
CLOB_AUDIT_LOG=clob_audit.jsonl

# Duplicate all slog JSON logs to this file as well as stdout (optional).
# LOG_FILE=logs/api.log

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polygon RPC (optional; used only if you add chain reads elsewhere)
POLYGON_RPC_URL=